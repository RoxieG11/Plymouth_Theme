////////////////////////////////////////////////////////////////////////////
// Roxie — Plymouth Boot Theme
//
// Pure black + purple, no other hues. Every pixel of the "ROXIE" wordmark
// (and its reveal animation) is a pre-rendered PNG produced by
// generate_assets.py — this script never draws text or shapes at boot
// time, it only positions, scales-once, and animates opacity. That keeps
// every tick of the boot animation cheap enough for integrated graphics.
//
// Structure of this file:
//   0. Tunable timing/appearance constants
//   1. Screen + background setup
//   2. Resolution-independent scale factor
//   3. Small math helper(s)
//   4. Logo — load + position (reveal flipbook + idle glow underlay)
//   5. Ambient background particles — load + position
//   6. Spinner — segmented chase ring — load + position
//   7. Password / passphrase prompt (LUKS, etc.)
//   8. Per-tick update functions
//   9. Master refresh loop + boot-complete fade-out/quit
//  10. Callback registration
////////////////////////////////////////////////////////////////////////////


////////////////////////////////////////////////////////////////////////////
// 0. Tunable constants — change timings/sizes here, nowhere else.
////////////////////////////////////////////////////////////////////////////
refresh_rate            = 30;    // animation ticks per second

particle_count           = 22;
particle_fade_ticks      = 9;    // ~300ms @ 30fps — matches the brief's intro timing
particle_idle_opacity    = 0.20;
particle_twinkle_period  = 150;  // ticks per lazy twinkle cycle (~5s)

logo_reveal_frame_count  = 28;   // must match logo/frame_00..27.png
logo_reveal_start_tick   = 9;    // wait for the particle fade before the line starts
logo_reveal_tick_stride  = 1;    // 1 flipbook frame per tick

breathing_period_ticks   = 80;   // ~2.6s @ 30fps, matches "every 2-3 seconds"
breathing_amplitude      = 0.10; // small — opacity changes only a little
breathing_base_opacity   = 0.65;

spinner_dot_count           = 12;
spinner_advance_every_ticks = 4; // full revolution ≈ 48 ticks ≈ 1.6s
spinner_trail_length        = 4;
spinner_min_opacity         = 0.10;
spinner_fade_in_start_tick  = 20;
spinner_fade_in_ticks       = 15;

quit_fade_ticks = 20;            // ~0.65s @ 30fps fade-to-black on boot complete

// Assets were rendered "4K-native" at this reference pixel width so they are
// only ever scaled DOWN (never up) — see generate_assets.py SCALE constant.
logo_reference_width = 3840;

// Per-asset trim multipliers on top of the shared ui_scale below. The logo
// canvas already bakes in the correct on-screen proportion (~38% of screen
// width), so it uses ui_scale directly; particles/spinner/bullets are much
// smaller design elements and were tuned separately.
particle_scale_factor = 0.55;
spinner_scale_factor  = 0.34;
bullet_scale_factor   = 0.90;

max_bullets = 32;                // hard cap on rendered password-dot glyphs


////////////////////////////////////////////////////////////////////////////
// 1. Screen + background — pure black, no gradient banding.
////////////////////////////////////////////////////////////////////////////
screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

Plymouth.SetRefreshRate(refresh_rate);


////////////////////////////////////////////////////////////////////////////
// 2. Resolution-independent scale factor.
//    1920x1080 / 2560x1440 / 4K are all supported by scaling the same
//    4K-native art DOWN — never up — so edges stay crisp everywhere.
////////////////////////////////////////////////////////////////////////////
ui_scale = screen_width / logo_reference_width;
if (ui_scale > 1) {
    ui_scale = 1;
}
if (ui_scale < 0.28) {
    ui_scale = 0.28;
}


////////////////////////////////////////////////////////////////////////////
// 3. Small math helper — a dependable non-negative modulo, used by the
//    spinner so we do not rely on any particular "%" operator behaviour.
////////////////////////////////////////////////////////////////////////////
fun mod(a, b)
{
    r = a - Math.Int(a / b) * b;
    if (r < 0) {
        r = r + b;
    }
    return r;
}


////////////////////////////////////////////////////////////////////////////
// 4. Logo — reveal flipbook + idle glow underlay.
////////////////////////////////////////////////////////////////////////////
logo_final_base = Image("logo_final.png");
logo_w = Math.Int(logo_final_base.GetWidth() * ui_scale);
logo_h = Math.Int(logo_final_base.GetHeight() * ui_scale);
logo_final_img = logo_final_base.Scale(logo_w, logo_h);

logo_glow_base = Image("logo_glow.png");           // same canvas size as logo_final
logo_glow_img  = logo_glow_base.Scale(logo_w, logo_h);

// Load + pre-scale every reveal frame once at start — a one-time cost, not
// a per-tick one. Filenames are logo/frame_00.png .. logo/frame_27.png.
for (i = 0; i < logo_reveal_frame_count; i++) {
    if (i < 10) {
        frame_path = "logo/frame_0" + i + ".png";
    } else {
        frame_path = "logo/frame_" + i + ".png";
    }
    logo_frame_raw = Image(frame_path);
    logo_frame[i] = logo_frame_raw.Scale(logo_w, logo_h);
}

logo_x = Math.Int((screen_width  - logo_w) / 2);
logo_y = Math.Int((screen_height - logo_h) / 2 - screen_height * 0.05);

logo_glow_sprite = Sprite();
logo_glow_sprite.SetImage(logo_glow_img);
logo_glow_sprite.SetX(logo_x);
logo_glow_sprite.SetY(logo_y);
logo_glow_sprite.SetZ(9);
logo_glow_sprite.SetOpacity(0);

logo_sprite = Sprite();
logo_sprite.SetImage(logo_frame[0]);
logo_sprite.SetX(logo_x);
logo_sprite.SetY(logo_y);
logo_sprite.SetZ(10);
logo_sprite.SetOpacity(0);

logo_intro_done = 0;
logo_bottom_y   = logo_y + logo_h;


////////////////////////////////////////////////////////////////////////////
// 5. Ambient background particles — faint purple flecks. Positions are
//    randomised once and never move again; only opacity is touched each
//    tick, which is what keeps this practically free to run.
////////////////////////////////////////////////////////////////////////////
particle_base_img = Image("particle.png");
particle_scale = ui_scale * particle_scale_factor;
particle_img = particle_base_img.Scale(
    Math.Int(particle_base_img.GetWidth()  * particle_scale),
    Math.Int(particle_base_img.GetHeight() * particle_scale)
);

for (i = 0; i < particle_count; i++) {
    particle_sprite[i] = Sprite();
    particle_sprite[i].SetImage(particle_img);
    particle_sprite[i].SetX(Math.Int(Math.Random() * screen_width));
    particle_sprite[i].SetY(Math.Int(Math.Random() * screen_height));
    particle_sprite[i].SetZ(1);
    particle_sprite[i].SetOpacity(0);
    particle_phase[i] = Math.Random() * Math.Pi * 2;
}


////////////////////////////////////////////////////////////////////////////
// 6. Spinner — a small segmented ring with a soft comet chasing around it.
//    Dot positions are computed once; only opacity changes per tick.
////////////////////////////////////////////////////////////////////////////
spinner_base_img = Image("spinner_dot.png");
spinner_scale = ui_scale * spinner_scale_factor;
spinner_img = spinner_base_img.Scale(
    Math.Int(spinner_base_img.GetWidth()  * spinner_scale),
    Math.Int(spinner_base_img.GetHeight() * spinner_scale)
);

spinner_radius    = screen_height * 0.032;
spinner_center_x  = screen_width / 2;
spinner_center_y  = logo_bottom_y + screen_height * 0.07;

for (i = 0; i < spinner_dot_count; i++) {
    angle = (i / spinner_dot_count) * Math.Pi * 2 - (Math.Pi / 2);
    dot_x = spinner_center_x + spinner_radius * Math.Cos(angle) - spinner_img.GetWidth()  / 2;
    dot_y = spinner_center_y + spinner_radius * Math.Sin(angle) - spinner_img.GetHeight() / 2;

    spinner_sprite[i] = Sprite();
    spinner_sprite[i].SetImage(spinner_img);
    spinner_sprite[i].SetX(Math.Int(dot_x));
    spinner_sprite[i].SetY(Math.Int(dot_y));
    spinner_sprite[i].SetZ(10);
    spinner_sprite[i].SetOpacity(0);
}


////////////////////////////////////////////////////////////////////////////
// 7. Password / passphrase prompt (LUKS full-disk encryption, etc).
//    Minimal and on-brand: one small label line + a row of soft glowing
//    dots, one per character typed. Invisible the rest of the time.
////////////////////////////////////////////////////////////////////////////
bullet_base_img = Image("bullet.png");
bullet_scale = ui_scale * bullet_scale_factor;
bullet_img = bullet_base_img.Scale(
    Math.Int(bullet_base_img.GetWidth()  * bullet_scale),
    Math.Int(bullet_base_img.GetHeight() * bullet_scale)
);

prompt_sprite = Sprite();
prompt_sprite.SetZ(20);
prompt_sprite.SetOpacity(0);

for (i = 0; i < max_bullets; i++) {
    bullet_sprite[i] = Sprite();
    bullet_sprite[i].SetImage(bullet_img);
    bullet_sprite[i].SetZ(20);
    bullet_sprite[i].SetOpacity(0);
}

password_font_pt = Math.Int(15 * (screen_width / 1920));
if (password_font_pt < 11) {
    password_font_pt = 11;
}
password_font = "Sans " + password_font_pt;

fun show_password_prompt(prompt_text, bullets)
{
    label = prompt_text;
    if (label == "") {
        label = "Enter passphrase to unlock disk";
    }

    // Soft lavender-white — legible, still inside the palette.
    label_img = Image.Text(label, 0.86, 0.80, 0.98, 1, password_font);
    label_x = Math.Int(screen_width / 2 - label_img.GetWidth() / 2);
    label_y = Math.Int(spinner_center_y + screen_height * 0.06);

    prompt_sprite.SetImage(label_img);
    prompt_sprite.SetX(label_x);
    prompt_sprite.SetY(label_y);
    prompt_sprite.SetOpacity(1);

    bullet_gap   = bullet_img.GetWidth() * 1.4;
    bullets_w    = bullets * bullet_gap;
    bullets_x0   = screen_width / 2 - bullets_w / 2;
    bullets_y    = label_y + label_img.GetHeight() + screen_height * 0.02;

    for (i = 0; i < max_bullets; i++) {
        if (i < bullets) {
            bullet_sprite[i].SetX(Math.Int(bullets_x0 + i * bullet_gap));
            bullet_sprite[i].SetY(Math.Int(bullets_y));
            bullet_sprite[i].SetOpacity(1);
        } else {
            bullet_sprite[i].SetOpacity(0);
        }
    }
}

fun display_password_callback(prompt_text, bullets)
{
    show_password_prompt(prompt_text, bullets);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt_text, entry)
{
    // Same minimal styling as the password prompt (no bullet count given
    // for a plain question, so just show the label).
    show_password_prompt(prompt_text, 0);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback()
{
    prompt_sprite.SetOpacity(0);
    for (i = 0; i < max_bullets; i++) {
        bullet_sprite[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);


////////////////////////////////////////////////////////////////////////////
// 8. Per-tick update functions — each one is cheap: a handful of Sin/Cos
//    and SetOpacity calls, nothing re-rendered, nothing re-decoded.
////////////////////////////////////////////////////////////////////////////

// -- Particles: fade in once, then a slow, gently offset per-particle
//    twinkle so they never pulse in unison (would read as "flashing").
fun update_particles(t)
{
    for (i = 0; i < particle_count; i++) {
        if (t < particle_fade_ticks) {
            op = particle_idle_opacity * (t / particle_fade_ticks);
        } else {
            twinkle = Math.Sin((t / particle_twinkle_period) * Math.Pi * 2 + particle_phase[i]);
            op = particle_idle_opacity * (0.65 + 0.35 * twinkle);
        }
        particle_sprite[i].SetOpacity(op * master_fade);
    }
}

// -- Logo: play the reveal flipbook once, then hold on the crisp static
//    asset and only ever touch the soft glow underlay's opacity (the
//    "breathing"). The wordmark itself never flickers — only its halo.
fun update_logo(t)
{
    if (t < logo_reveal_start_tick) {
        return;
    }

    if (logo_intro_done == 0) {
        reveal_tick = t - logo_reveal_start_tick;
        frame_index = Math.Int(reveal_tick / logo_reveal_tick_stride);
        if (frame_index >= logo_reveal_frame_count) {
            frame_index = logo_reveal_frame_count - 1;
        }

        logo_sprite.SetImage(logo_frame[frame_index]);
        logo_sprite.SetOpacity(1 * master_fade);

        if (frame_index == logo_reveal_frame_count - 1) {
            logo_intro_done = 1;
            logo_sprite.SetImage(logo_final_img);   // hand off to the static crisp asset
        }
        return;
    }

    logo_sprite.SetOpacity(1 * master_fade);

    breathe  = Math.Sin((t / breathing_period_ticks) * Math.Pi * 2);
    glow_op  = breathing_base_opacity + breathing_amplitude * breathe;
    logo_glow_sprite.SetOpacity(glow_op * master_fade);
}

// -- Spinner: fades in while the logo is still resolving, then a single
//    bright dot chases around the ring with a short fading trail behind
//    it and a very faint resting ring visible the rest of the time.
fun update_spinner(t)
{
    fade = (t - spinner_fade_in_start_tick) / spinner_fade_in_ticks;
    if (fade < 0) {
        fade = 0;
    }
    if (fade > 1) {
        fade = 1;
    }
    if (fade <= 0) {
        return;
    }

    head = mod(Math.Int(t / spinner_advance_every_ticks), spinner_dot_count);

    for (i = 0; i < spinner_dot_count; i++) {
        trail_dist = mod(head - i, spinner_dot_count);

        if (trail_dist == 0) {
            level = 1.0;
        } else {
            if (trail_dist <= spinner_trail_length) {
                level = 1.0 - (trail_dist / (spinner_trail_length + 1));
            } else {
                level = 0.0;
            }
        }

        op = spinner_min_opacity + (1.0 - spinner_min_opacity) * level;
        spinner_sprite[i].SetOpacity(op * fade * master_fade);
    }
}


////////////////////////////////////////////////////////////////////////////
// 9. Master refresh loop + boot-complete fade-out/quit.
//
//    On boot completion Plymouth calls quit_callback; we do not block
//    there — we just start ramping master_fade down to 0, and every
//    update_* function above already multiplies its opacity by
//    master_fade, so everything dims to black together. Once the fade
//    finishes we call Plymouth.Quit() to hand control back.
////////////////////////////////////////////////////////////////////////////
tick            = 0;
quitting        = 0;
quit_fade_tick  = 0;
master_fade     = 1;

fun refresh_callback()
{
    tick++;

    if (quitting == 1) {
        quit_fade_tick++;
        master_fade = 1.0 - (quit_fade_tick / quit_fade_ticks);
        if (master_fade < 0) {
            master_fade = 0;
        }
    }

    update_particles(tick);
    update_logo(tick);
    update_spinner(tick);

    if (quitting == 1) {
        if (master_fade <= 0) {
            Plymouth.Quit();
        }
    }
}

fun quit_callback()
{
    quitting = 1;
}


////////////////////////////////////////////////////////////////////////////
// 10. Register callbacks with Plymouth — always last.
////////////////////////////////////////////////////////////////////////////
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetQuitFunction(quit_callback);
